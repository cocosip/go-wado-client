# Normalize all text files to LF in the repository and in the working tree.
# Go tooling (gofmt) and CI run on Linux, so CRLF checkouts on Windows would
# otherwise make `gofmt -l` report every file as unformatted.
* text=auto eol=lf

*.go   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf

# Binary artifacts must never be line-ending converted.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.dcm  binary
*.exe  binary
*.dll  binary
